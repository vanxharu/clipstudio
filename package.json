{
  "name": "html2video-studio",
  "productName": "HTML Video Studio",
  "version": "1.3.0",
  "description": "Biến HTML/CSS/JS thành video MP4: xem trước, render bằng Edge/Chrome + FFmpeg, giọng đọc TTS, nhạc nền tự tạo.",
  "author": "HTML Video Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanxharu/clipstudio.git"
  },
  "main": "electron/main.js",
  "bin": {
    "html2video": "render.js"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "render": "node render.js",
    "app": "node build.js && electron .",
    "dist": "node build.js && electron-builder --win --publish never",
    "setup": "npx playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.html2video.studio",
    "productName": "HTML Video Studio",
    "copyright": "HTML Video Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "lib/**",
      "src/timeshim.js",
      "public/**",
      "examples/**",
      "build/icon.png",
      "server.js",
      "render.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HTML-Video-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HTML Video Studio"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/rhubarb",
        "to": "rhubarb",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
